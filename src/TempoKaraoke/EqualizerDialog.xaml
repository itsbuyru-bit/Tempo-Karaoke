<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TempoKaraoke.EqualizerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" />
            <ToggleSwitch
                x:Name="EnabledToggle"
                Grid.Column="1"
                MinWidth="0"
                Toggled="EnabledToggle_Toggled" />
        </Grid>
    </ContentDialog.Title>
    <StackPanel MinWidth="760" Spacing="16">
        <StackPanel
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock x:Name="PresetLabel" VerticalAlignment="Center" />
            <ComboBox
                x:Name="PresetComboBox"
                MinWidth="240"
                SelectionChanged="PresetComboBox_SelectionChanged" />
        </StackPanel>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="160" Margin="0,0,4,22" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ScalePlus12" Grid.Row="0" VerticalAlignment="Top" />
                <TextBlock x:Name="ScalePlus6" Grid.Row="1" VerticalAlignment="Center" />
                <TextBlock x:Name="ScaleZero" Grid.Row="2" VerticalAlignment="Center" />
                <TextBlock x:Name="ScaleMinus6" Grid.Row="3" VerticalAlignment="Center" />
                <TextBlock x:Name="ScaleMinus12" Grid.Row="4" VerticalAlignment="Bottom" />
            </Grid>
            <Grid
                x:Name="SlidersGrid"
                Grid.Column="1"
                ColumnSpacing="4" />
        </Grid>
        <CheckBox x:Name="LinkSlidersCheckBox" />
    </StackPanel>
</ContentDialog>
