<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TempoKaraoke.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="12,8"
            Orientation="Horizontal"
            Spacing="8">
            <Button x:Name="OpenButton" Click="Open_Click" Content="Открыть видео" />
            <Button x:Name="SampleButton" Click="Sample_Click" Content="Sample из G:\Karaoke" />
            <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Content="Пауза" IsEnabled="False" />
            <Button x:Name="StopButton" Click="Stop_Click" Content="Стоп" IsEnabled="False" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Инициализация libvlc…" />
        </StackPanel>

        <vlc:VideoView
            x:Name="VideoView"
            Grid.Row="1"
            Background="Black" />

        <TextBlock
            x:Name="TimeText"
            Grid.Row="2"
            Padding="12,6"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="00:00 / 00:00" />
    </Grid>
</Page>
