<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TempoKaraoke.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TempoKaraoke.Models"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="Transparent" />
    </Page.Resources>

    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="320"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Content="Главная" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="LibraryNavItem"
                    Content="Библиотека видео"
                    IsSelected="True"
                    Tag="library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="QueueNavItem" Content="Очередь" Tag="queue">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PlaylistsNavItem" Content="Плейлисты" Tag="playlists">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Параметры" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneHeader>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Margin="8,64,8,8"
                    PlaceholderText="Поиск"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />
            </NavigationView.PaneHeader>

            <Grid Padding="0,56,0,0">
        <!--  Главная  -->
        <Grid
            x:Name="HomeView"
            Padding="20,0,20,12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="20,16">
                <StackPanel Spacing="2">
                    <TextBlock Text="Главная" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Недавние песни и быстрый доступ" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="20,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Недавние файлы" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="RecentList"
                                DoubleTapped="RecentList_DoubleTapped"
                                IsItemClickEnabled="True"
                                ItemsSource="{x:Bind Recent, Mode=OneWay}"
                                KeyDown="RecentList_KeyDown"
                                SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="4" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MediaItem">
                                        <Grid Padding="8,6" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind DisplayTitle, Mode=OneTime}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <TextBlock
                                                    Text="{x:Bind Subtitle, Mode=OneTime}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Click="AddToQueue_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Добавить в очередь">
                                                <SymbolIcon Symbol="Add" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="RecentEmptyText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsHitTestVisible="False"
                                Text="Пока ничего не играло" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Padding="20,16" Spacing="10">
                        <TextBlock Text="Быстрый доступ" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OpenLibrary_Click"
                            Content="Открыть библиотеку" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OpenQueue_Click"
                            Content="Очередь" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="AddVideoFolder_Click"
                            Content="Добавить папку" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OpenSettings_Click"
                            Content="Параметры" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  Библиотека видео  -->
        <Grid
            x:Name="LibraryView"
            Padding="20,0,20,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Библиотека  -->
            <Border
                x:Name="LibraryPanel"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="20,16" Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="Библиотека видео"
                                    Style="{StaticResource TitleTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    x:Name="StatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Читаю медиатеку…"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="ScanButton"
                                    Click="Scan_Click"
                                    ToolTipService.ToolTip="Обновить список">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                                <Button
                                    Click="AddVideoFolder_Click"
                                    Content="Добавить папку" />
                                <Button
                                    Click="PlayAll_Click"
                                    Content="Воспроизвести все" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox
                                x:Name="FolderFilter"
                                MinWidth="160"
                                PlaceholderText="Все папки"
                                SelectionChanged="FolderFilter_SelectionChanged" />
                            <ComboBox
                                x:Name="SortComboBox"
                                MinWidth="150"
                                SelectionChanged="SortComboBox_SelectionChanged">
                                <ComboBoxItem Content="Исполнитель" Tag="artist" />
                                <ComboBoxItem Content="Название" Tag="title" />
                                <ComboBoxItem Content="Коллекция" Tag="folder" />
                            </ComboBox>
                            <TextBlock
                                x:Name="CountText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="0 песен" />
                        </StackPanel>
                    </StackPanel>

                    <TabView
                        x:Name="LibraryTabs"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        IsAddTabButtonVisible="False"
                        TabWidthMode="Equal"
                        VerticalContentAlignment="Stretch">
                        <TabViewItem
                            HorizontalContentAlignment="Stretch"
                            IsClosable="False"
                            VerticalContentAlignment="Stretch"
                            Header="Все видео">
                            <GridView
                                x:Name="LibraryList"
                                Padding="12,8,12,12"
                                DoubleTapped="LibraryList_DoubleTapped"
                                HorizontalAlignment="Stretch"
                                IsItemClickEnabled="True"
                                ItemsSource="{x:Bind Filtered, Mode=OneWay}"
                                KeyDown="LibraryList_KeyDown"
                                SelectionMode="Single">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            ItemHeight="230"
                                            ItemWidth="250"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="4" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MediaItem">
                                        <Grid
                                            Width="230"
                                            Height="210"
                                            Padding="8"
                                            RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="110" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <FontIcon
                                                        Grid.Column="0"
                                                        FontSize="36"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE714;"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                    <Border
                                                        Padding="6,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Background="#66000000"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="White"
                                                            Text="{x:Bind Format, Mode=OneTime}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <TextBlock
                                                Grid.Row="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind DisplayTitle, Mode=OneTime}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />

                                            <Grid Grid.Row="2" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Subtitle, Mode=OneTime}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <Button
                                                    Grid.Column="1"
                                                    Click="AddToQueue_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Добавить в очередь">
                                                    <SymbolIcon Symbol="Add" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </TabViewItem>

                        <TabViewItem
                            HorizontalContentAlignment="Stretch"
                            IsClosable="False"
                            VerticalContentAlignment="Stretch"
                            Header="Папки с видео">
                            <ListView
                                x:Name="FolderList"
                                Padding="12,8,12,12"
                                DoubleTapped="FolderList_DoubleTapped"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind FolderGroups, Mode=OneWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FolderInfo">
                                        <Grid Padding="8,8" ColumnSpacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind Name, Mode=OneTime}"
                                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind Label, Mode=OneTime}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabViewItem>
                    </TabView>
                </Grid>
            </Border>

            <!--  Очередь  -->
            <Grid
                x:Name="QueueView"
                Grid.Column="0"
                Visibility="Collapsed">
                <Border
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="20,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Очередь воспроизведения" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="QueueCountText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="0 песен" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Click="ClearQueue_Click"
                                    ToolTipService.ToolTip="Очистить очередь">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Delete" />
                                        <TextBlock Text="Очистить" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Content="Добавить в"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Плейлисты — следующий этап" />
                                <SplitButton
                                    Click="AddFilesSplitButton_Click"
                                    Content="Добавить файлы">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="AddFiles_Click"
                                                Text="Добавить файлы в очередь">
                                                <MenuFlyoutItem.Icon>
                                                    <SymbolIcon Symbol="OpenFile" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="AddFolderToQueue_Click"
                                                Text="Добавить папку в очередь">
                                                <MenuFlyoutItem.Icon>
                                                    <SymbolIcon Symbol="Folder" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="AddUrlToQueue_Click"
                                                Text="Добавить по URL">
                                                <MenuFlyoutItem.Icon>
                                                    <SymbolIcon Symbol="Link" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </StackPanel>
                        </Grid>

                        <ListView
                            x:Name="QueueList"
                            Grid.Row="1"
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            Padding="12,0,12,12"
                            DoubleTapped="QueueList_DoubleTapped"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind Queue, Mode=OneWay}"
                            KeyDown="QueueList_KeyDown"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaItem">
                                    <Grid Padding="8,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind DisplayTitle, Mode=OneTime}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Text="{x:Bind Subtitle, Mode=OneTime}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="RemoveFromQueue_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Убрать из очереди">
                                            <SymbolIcon Symbol="Remove" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                x:Name="PlaceholderView"
                Grid.Column="0"
                Padding="32,24"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="PlaceholderText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                x:Name="SettingsView"
                Grid.Column="0"
                Visibility="Collapsed">
                <StackPanel
                    Padding="24,16,24,24"
                    Spacing="12">
                    <TextBlock Text="Параметры" Style="{StaticResource TitleTextBlockStyle}" />

                    <TextBlock Text="Библиотеки" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        IsExpanded="False">
                        <Expander.Header>
                            <Grid MinHeight="56" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="20" Glyph="&#xE8B7;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Пути к библиотеке видео"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button
                                    x:Name="AddVideoFolderButton"
                                    Grid.Column="2"
                                    Click="AddVideoFolder_Click"
                                    Content="Добавить папку" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="10" Padding="0,8,0,0">
                            <ListView
                                x:Name="VideoRootsList"
                                MaxHeight="180"
                                ItemsSource="{x:Bind VideoRoots, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <Button
                                                Grid.Column="1"
                                                Click="RemoveVideoFolder_Click"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="Убрать папку">
                                                <SymbolIcon Symbol="Remove" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Text="Индексируются только видеофайлы. Музыка не индексируется."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        IsExpanded="False">
                        <Expander.Header>
                            <Grid MinHeight="56" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="20" Glyph="&#xE72C;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Обновить библиотеки"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Button
                                    x:Name="RefreshLibrariesButton"
                                    Grid.Column="2"
                                    Click="RefreshLibraries_Click"
                                    Content="Обновить" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="0,8,0,0">
                            <TextBlock
                                Text="Если вы видите не все файлы, повторите индексацию."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <HyperlinkButton
                                Click="OpenIndexingSettings_Click"
                                Content="Управление параметрами индексирования системы" />
                        </StackPanel>
                    </Expander>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Персонализация"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        IsExpanded="False">
                        <Expander.Header>
                            <Grid MinHeight="56" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="20" Glyph="&#xE790;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Тема приложения"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </Expander.Header>
                        <ComboBox
                            x:Name="ThemeComboBox"
                            Padding="0,8,0,0"
                            SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Использовать параметры системы" Tag="system" />
                            <ComboBoxItem Content="Светлая" Tag="light" />
                            <ComboBoxItem Content="Тёмная" Tag="dark" />
                        </ComboBox>
                    </Expander>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        IsExpanded="False">
                        <Expander.Header>
                            <Grid MinHeight="56" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="20" Glyph="&#xE793;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Контрастный цвет"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="0,8,0,0">
                            <ComboBox
                                x:Name="AccentComboBox"
                                SelectionChanged="AccentComboBox_SelectionChanged">
                                <ComboBoxItem Content="Использовать системный акцент" Tag="system" />
                            </ComboBox>
                            <TextBlock
                                Text="Пользовательские акценты — следующий этап."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0"
                        CornerRadius="8"
                        IsExpanded="False">
                        <Expander.Header>
                            <Grid MinHeight="56" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="20" Glyph="&#xEB9F;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="Обложки"
                                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="0,8,0,0">
                            <ToggleSwitch
                                x:Name="ArtworkToggle"
                                Header="Искать обложки в Интернете"
                                Toggled="ArtworkToggle_Toggled" />
                            <TextBlock
                                Text="Обложки появятся вместе с метаданными в следующем этапе."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
            </Grid>
        </NavigationView>

        <!--  Шапка: меню, назад, иконка и название  -->
        <Grid
            x:Name="AppHeader"
            Grid.Row="0"
            Width="320"
            Height="56"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Border x:Name="AppHeaderDragArea" Background="Transparent" />
            <StackPanel
                Padding="8,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="HeaderMenuButton"
                    AutomationProperties.AutomationId="HeaderMenuButton"
                    Click="HeaderMenu_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Скрыть/показать меню">
                    <FontIcon FontSize="18" Glyph="&#xE700;" />
                </Button>
                <Button
                    x:Name="HeaderBackButton"
                    AutomationProperties.AutomationId="HeaderBackButton"
                    Click="HeaderBack_Click"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Назад"
                    Visibility="Collapsed">
                    <FontIcon FontSize="18" Glyph="&#xE72B;" />
                </Button>
                <Border
                    x:Name="HeaderIcon"
                    Width="24"
                    Height="24"
                    Margin="4,0,0,0"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12">
                    <FontIcon
                        FontSize="11"
                        Foreground="White"
                        Glyph="&#xE768;" />
                </Border>
                <TextBlock
                    x:Name="HeaderTitle"
                    MaxWidth="190"
                    VerticalAlignment="Center"
                    Text="Tempo Karaoke"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!--  Транспорт  -->
        <Border
            x:Name="TransportBar"
            Grid.Row="1"
            Padding="16,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CurrentTimeText"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="00:00" />
                    <Slider
                        x:Name="SeekSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        Minimum="0"
                        PointerCaptureLost="SeekSlider_PointerCaptureLost"
                        PointerPressed="SeekSlider_PointerPressed"
                        PointerReleased="SeekSlider_PointerReleased"
                        StepFrequency="1000"
                        ValueChanged="SeekSlider_ValueChanged" />
                    <TextBlock
                        x:Name="TotalTimeText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="00:00" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="160"
                            Height="90"
                            Background="Black"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <vlc:VideoView x:Name="VideoView" Background="Black" />
                                <Border
                                    x:Name="MiniPlayerOverlay"
                                    Background="Transparent"
                                    PointerEntered="MiniPlayer_PointerEntered"
                                    PointerExited="MiniPlayer_PointerExited"
                                    Tapped="MiniPlayer_Tapped"
                                    ToolTipService.ToolTip="Открыть видео на всё окно" />
                            </Grid>
                        </Border>

                        <StackPanel
                            MaxWidth="320"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                x:Name="BarTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Ничего не играет"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                x:Name="BarSubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Выберите песню двойным кликом"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <ToggleButton
                            x:Name="ShuffleButton"
                            Click="Shuffle_Click"
                            Style="{StaticResource IconToggleButtonStyle}"
                            ToolTipService.ToolTip="Перемешать">
                            <FontIcon FontSize="18" Glyph="&#xE8B1;" />
                        </ToggleButton>
                        <Button
                            x:Name="PreviousButton"
                            Click="Previous_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Предыдущая (Ctrl+←)">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <Button
                            x:Name="PlayPauseButton"
                            Width="56"
                            Height="56"
                            Padding="0"
                            Click="PlayPause_Click"
                            CornerRadius="28"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Играть/пауза (Space)">
                            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                        </Button>
                        <Button
                            x:Name="NextButton"
                            Click="Next_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Следующая (Ctrl+→)">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                        <ToggleButton
                            x:Name="RepeatButton"
                            Click="Repeat_Click"
                            Style="{StaticResource IconToggleButtonStyle}"
                            ToolTipService.ToolTip="Повторять очередь">
                            <FontIcon FontSize="18" Glyph="&#xE8EE;" />
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            Click="MediaInfo_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Информация о медиа">
                            <FontIcon FontSize="18" Glyph="&#xE946;" />
                        </Button>
                        <Button
                            x:Name="MuteButton"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Громкость">
                            <SymbolIcon x:Name="MuteIcon" Symbol="Volume" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel
                                        Width="360"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <Button
                                            AutomationProperties.AutomationId="PopupMuteButton"
                                            Click="Mute_Click"
                                            ToolTipService.ToolTip="Выключить звук">
                                            <SymbolIcon x:Name="PopupMuteIcon" Symbol="Volume" />
                                        </Button>
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Width="220"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            ValueChanged="VolumeSlider_ValueChanged" />
                                        <TextBlock
                                            x:Name="VolumeValueText"
                                            Width="40"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="VolumeValueText"
                                            FontFamily="Consolas"
                                            Text="100"
                                            TextAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="FullScreenButton"
                            Click="FullScreen_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Полный экран (F11)">
                            <SymbolIcon Symbol="FullScreen" />
                        </Button>
                        <Button
                            x:Name="DetachButton"
                            Click="Detach_Click"
                            IsEnabled="False"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Открепить видео">
                            <FontIcon FontSize="18" Glyph="&#xE8A6;" />
                        </Button>
                        <Button
                            x:Name="MoreButton"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Ещё">
                            <FontIcon FontSize="18" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="SkipBack_Click" Text="−10 секунд" />
                                    <MenuFlyoutItem Click="SkipForward_Click" Text="+30 секунд" />
                                    <MenuFlyoutItem Click="Stop_Click" Text="Стоп" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="MediaInfo_Click" Text="Информация о медиа" />
                                    <MenuFlyoutItem Click="Detach_Click" Text="Открепить видео" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Строка, когда видео откреплено  -->
        <Border
            x:Name="DetachedBar"
            Grid.Row="1"
            Padding="20,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="DetachedTitle"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Видео в отдельном окне"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Button
                    Grid.Column="1"
                    Click="ReturnVideo_Click"
                    Content="Вернуть видео"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
