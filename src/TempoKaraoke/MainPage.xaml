                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8EE;"
                                    Opacity="0.75" />
                                <FontIcon
                                    x:Name="RepeatIconActive"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8EE;"
                                    Visibility="Collapsed" />
                                <Line
                                    x:Name="RepeatSlash"
                                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                    StrokeThickness="1.5"
                                    Opacity="0.75"
                                    Visibility="Collapsed"
                                    X1="2"
                                    X2="16"
                                    Y1="2"
                                    Y2="16" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
 x:Name="MuteButton" Style="{StaticResource IconButtonStyle}" loc:Localization.AutomationNameKey="Ui_Volume_AutomationName.AutomationName" loc:Localization.ToolTipKey="Ui_Volume_ToolTip.ToolTip">
                            <SymbolIcon x:Name="MuteIcon" Symbol="Volume" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel
                                        Padding="2,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
 AutomationProperties.AutomationId="PopupMuteButton" Click="Mute_Click" Style="{StaticResource IconButtonStyle}" loc:Localization.ToolTipKey="Ui_Mute_ToolTip.ToolTip">
                                            <SymbolIcon x:Name="PopupMuteIcon" Symbol="Volume" />
                                        </Button>
                                        <Slider
 x:Name="VolumeSlider" Width="190" VerticalAlignment="Center" Maximum="100" Minimum="0" ValueChanged="VolumeSlider_ValueChanged" loc:Localization.AutomationNameKey="Ui_Volume_178_AutomationName.AutomationName" />
                                        <TextBlock
                                            x:Name="VolumeValueText"
                                            Width="32"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="VolumeValueText"
                                            FontSize="14"
                                            Text="100"
                                            TextAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
 x:Name="FullScreenButton" Click="FullScreen_Click" Style="{StaticResource IconButtonStyle}" loc:Localization.AutomationNameKey="Ui_FullScreen_AutomationName.AutomationName" loc:Localization.ToolTipKey="Ui_FullScreen_ToolTip.ToolTip">
                            <SymbolIcon Symbol="FullScreen" />
                        </Button>
                        <Button
 x:Name="DetachButton" Click="Detach_Click" IsEnabled="False" Style="{StaticResource IconButtonStyle}" loc:Localization.AutomationNameKey="Ui_DetachVideo_AutomationName.AutomationName" loc:Localization.ToolTipKey="Ui_DetachVideo_ToolTip.ToolTip">
                            <FontIcon FontSize="18" Glyph="&#xE93A;" />
                        </Button>
                        <Button
 x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" loc:Localization.AutomationNameKey="Ui_More_181_AutomationName.AutomationName" loc:Localization.ToolTipKey="Ui_More_181_ToolTip.ToolTip">
                            <FontIcon FontSize="18" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout Opening="MoreFlyout_Opening">
                                    <MenuFlyoutItem Click="MediaInfo_Click" x:Uid="ContextMenu_Properties" loc:Localization.Key="ContextMenu_Properties.Text">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="I" Modifiers="Control" />
                                        </MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="Equalizer_Click" x:Uid="Ui_Equalizer" loc:Localization.Key="Ui_Equalizer.Text">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE9E9;" />
                                        </MenuFlyoutItem.Icon>
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="E" Modifiers="Control,Shift" />
                                        </MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSubItem x:Name="PlaybackRateMenu" x:Uid="Ui_PlaybackRate" loc:Localization.Key="Ui_PlaybackRate.Text">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xEC57;" />
                                        </MenuFlyoutSubItem.Icon>
                                        <RadioMenuFlyoutItem
                                            x:Name="RateHalf"
                                            Click="PlaybackRate_Click"
                                            GroupName="PlaybackRate"
                                            Tag="0.5"
                                            Text="0.5x" />
                                        <RadioMenuFlyoutItem
                                            x:Name="RateThreeQuarters"
                                            Click="PlaybackRate_Click"
                                            GroupName="PlaybackRate"
                                            Tag="0.75"
                                            Text="0.75x" />
                                        <RadioMenuFlyoutItem
                                            x:Name="RateNormal"
                                            Click="PlaybackRate_Click"
                                            GroupName="PlaybackRate"
                                            IsChecked="True"
                                            Tag="1"
                                            x:Uid="Ui_RateNormal"
                                            loc:Localization.Key="Ui_RateNormal.Text" />
                                        <RadioMenuFlyoutItem
                                            x:Name="RateOneAndQuarter"
                                            Click="PlaybackRate_Click"
                                            GroupName="PlaybackRate"
                                            Tag="1.25"
                                            Text="1.25x" />
                                        <RadioMenuFlyoutItem
                                            x:Name="RateOneAndHalf"
                                            Click="PlaybackRate_Click"
                                            GroupName="PlaybackRate"
                                            Tag="1.5"
                                            Text="1.5x" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="SkipBack_Click" x:Uid="Ui_10Seconds" loc:Localization.Key="Ui_10Seconds.Text">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED3C;" />
                                        </MenuFlyoutItem.Icon>
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Left" Modifiers="Control" />
                                        </MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="SkipForward_Click" x:Uid="Ui_10Seconds_183" loc:Localization.Key="Ui_10Seconds_183.Text">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED3D;" />
                                        </MenuFlyoutItem.Icon>
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="Right" Modifiers="Control" />
                                        </MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Строка, когда видео откреплено  -->
        <Border
            x:Name="DetachedBar"
            Grid.Row="1"
            Padding="20,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
 x:Name="DetachedTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock
 Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="Ui_VideoIsPlayingInASeparateWindow" loc:Localization.Key="Ui_VideoIsPlayingInASeparateWindow.Text" />
                </StackPanel>
                <Button
 Grid.Column="1" Click="ReturnVideo_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="Ui_RestoreVideo" loc:Localization.Key="Ui_RestoreVideo.Content" />
            </Grid>
        </Border>

        <!--  Быстрый поиск по Ctrl+F  -->
        <Grid
            x:Name="QuickSearchOverlay"
            Grid.RowSpan="2"
            Background="#99000000"
            Tapped="QuickSearchOverlay_Tapped"
            Visibility="Collapsed">
            <Border
                Margin="80,60,80,0"
                Padding="16"
                VerticalAlignment="Top"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tapped="QuickSearchPanel_Tapped"
                Translation="0,0,24">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="8">
                    <AutoSuggestBox
 x:Name="QuickSearchBox" QueryIcon="Find" QuerySubmitted="QuickSearchBox_QuerySubmitted" TextChanged="QuickSearchBox_TextChanged" PreviewKeyDown="QuickSearchBox_PreviewKeyDown" IsSuggestionListOpen="False" UseSystemFocusVisuals="False" x:Uid="Ui_QuickSearch" loc:Localization.Key="Ui_QuickSearch.PlaceholderText" loc:Localization.AutomationNameKey="Ui_QuickSearch_AutomationName.AutomationName" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="QuickSearchFolderFilter"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="QuickSearchFilter_SelectionChanged" />
                        <ComboBox
                            x:Name="QuickSearchFormatFilter"
                            Grid.Column="1"
                            SelectionChanged="QuickSearchFilter_SelectionChanged" />
                        <ComboBox
                            x:Name="QuickSearchDurationFilter"
                            Grid.Column="2"
                            SelectionChanged="QuickSearchFilter_SelectionChanged" />
                    </Grid>
                    <TextBlock
                        x:Name="QuickSearchEmptyText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="Collapsed"
                        x:Uid="QuickSearch_NoResults"
                        loc:Localization.Key="QuickSearch_NoResults.Text" />
                    <ListView
                        x:Name="QuickSearchResults"
                        MaxHeight="360"
                        IsItemClickEnabled="False"
                        SelectionMode="Single"
                        UseSystemFocusVisuals="False">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickSearchResult">
                                <Grid
                                    Padding="4,6"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,10,0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="QuickSearchPlay_Click"
                                        CornerRadius="16"
                                        PointerEntered="QuickSearchPlayButton_PointerEntered"
                                        PointerExited="QuickSearchPlayButton_PointerExited"
                                        Tag="{Binding Item}"
                                        ToolTipService.Placement="Bottom"
                                        UseSystemFocusVisuals="False"
                                        loc:Localization.ToolTipKey="QuickSearch_Play.ToolTip">
                                        <Grid Width="32" Height="32">
                                            <FontIcon
                                                x:Name="VideoIcon"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="16"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE714;"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                            <FontIcon
                                                x:Name="PlayHoverIcon"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE768;"
                                                HorizontalAlignment="Center"
                                                Opacity="0"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <controls:HighlightedText
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Query="{Binding Query}"
                                            SourceText="{Binding DisplayTitle}" />
                                        <controls:HighlightedText
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Query="{Binding Query}"
                                            SourceText="{Binding Folder}" />
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{Binding VersionsText}"
                                            Visibility="{Binding HasMultipleVersions, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding DurationText}" />
                                    <Button
                                        Grid.Column="3"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="QuickSearchAddToQueue_Click"
                                        Style="{StaticResource QuickSearchActionButtonStyle}"
                                        Tag="{Binding Item}"
                                       
                                        loc:Localization.ToolTipKey="QuickSearch_AddToQueue.ToolTip">
                                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                                    </Button>
                                    <Button
                                        Grid.Column="4"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="QuickSearchMore_Click"
                                        Style="{StaticResource QuickSearchActionButtonStyle}"
                                        Tag="{Binding Item}"
                                       
                                        loc:Localization.ToolTipKey="QuickSearch_More.ToolTip">
                                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid
                        x:Name="QuickSearchFooter"
                        Padding="4,4,4,0"
                        ColumnSpacing="12"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="QuickSearchCountText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                        <HyperlinkButton
                            x:Name="QuickSearchShowAllButton"
                            Grid.Column="1"
                            Click="QuickSearchShowAll_Click"
                            x:Uid="QuickSearch_ShowAll"
                            loc:Localization.Key="QuickSearch_ShowAll.Content" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Отсчёт перед следующим треком в полноэкранном режиме  -->
        <Grid
            x:Name="FullScreenCountdownOverlay"
            Grid.RowSpan="2"
            Background="#E6000000"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
 HorizontalAlignment="Center" Foreground="White" Style="{StaticResource SubtitleTextBlockStyle}" x:Uid="Ui_NextIn_191" loc:Localization.Key="Ui_NextIn_191.Text" />
                <TextBlock
                    x:Name="FullScreenCountdownNextTitle"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="FullScreenCountdownValueText"
                    HorizontalAlignment="Center"
                    FontSize="72"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="10" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
 Click="CountdownPlayNow_Click" Style="{StaticResource AccentButtonStyle}" x:Uid="Ui_PlayNow" loc:Localization.Key="Ui_PlayNow.Content" />
                    <Button
 Click="CountdownCancel_Click" x:Uid="Ui_Cancel_193" loc:Localization.Key="Ui_Cancel_193.Content" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <!--  Пробы кистей: элементы, созданные в коде, берут цвета фактической темы окна  -->
        <Grid
            x:Name="ThemeBrushProbe"
            Width="0"
            Height="0"
            Opacity="0"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw">
            <TextBlock x:Name="PrimaryTextProbe" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SecondaryTextProbe" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="AccentTextProbe" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Border x:Name="LayerFillProbe" Background="{ThemeResource LayerFillColorDefaultBrush}" />
            <Border x:Name="CardFillProbe" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Border x:Name="CardFillSecondaryProbe" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Border x:Name="SubtleFillProbe" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Border x:Name="SuccessFillProbe" Background="{ThemeResource SystemFillColorSuccessBrush}" />
        </Grid>
    </Grid>
</Page>

