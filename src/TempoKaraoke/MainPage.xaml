<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TempoKaraoke.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TempoKaraoke.Models"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="LibraryNavItem"
                    Content="Библиотека видео"
                    IsSelected="True"
                    Tag="library">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Очередь" Tag="queue">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Плейлисты" Tag="playlists">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Параметры" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Верхняя строка: поиск и фильтр  -->
                <Grid Grid.Row="0" Padding="20,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        PlaceholderText="Поиск: исполнитель, название или папка"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" />

                    <ComboBox
                        x:Name="FolderFilter"
                        Grid.Column="1"
                        MinWidth="200"
                        PlaceholderText="Все папки"
                        SelectionChanged="FolderFilter_SelectionChanged" />

                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="0 песен" />
                </Grid>

        <!--  Три зоны: библиотека, плеер, очередь  -->
        <Grid
            x:Name="LibraryView"
            Grid.Row="1"
            Padding="20,0,20,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Библиотека  -->
            <Border
                x:Name="LibraryPanel"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Библиотека" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="StatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Читаю медиатеку…"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button
                            x:Name="ScanButton"
                            Grid.Column="1"
                            Click="Scan_Click"
                            ToolTipService.ToolTip="Обновить список">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="LibraryList"
                        Grid.Row="1"
                        Padding="8,0,8,8"
                        DoubleTapped="LibraryList_DoubleTapped"
                        IsItemClickEnabled="True"
                        ItemsSource="{x:Bind Filtered, Mode=OneWay}"
                        KeyDown="LibraryList_KeyDown"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <Grid Padding="8,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Text="{x:Bind DisplayTitle, Mode=OneTime}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Text="{x:Bind Subtitle, Mode=OneTime}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="AddToQueue_Click"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Добавить в очередь">
                                        <SymbolIcon Symbol="Add" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  Очередь  -->
            <Grid
                x:Name="QueueView"
                Grid.Column="0"
                Visibility="Collapsed">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="20,16" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Очередь воспроизведения" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="QueueCountText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="0 песен" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Click="ClearQueue_Click"
                                ToolTipService.ToolTip="Очистить очередь">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="Очистить" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView
                            x:Name="QueueList"
                            Grid.Row="1"
                            Padding="12,0,12,12"
                            DoubleTapped="QueueList_DoubleTapped"
                            IsItemClickEnabled="True"
                            ItemsSource="{x:Bind Queue, Mode=OneWay}"
                            KeyDown="QueueList_KeyDown"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaItem">
                                    <Grid Padding="8,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind DisplayTitle, Mode=OneTime}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Text="{x:Bind Subtitle, Mode=OneTime}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Click="RemoveFromQueue_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Убрать из очереди">
                                            <SymbolIcon Symbol="Remove" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                x:Name="PlaceholderView"
                Grid.Column="0"
                Padding="32,24"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="PlaceholderText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                x:Name="SettingsView"
                Grid.Column="0"
                Visibility="Collapsed">
                <StackPanel
                    Padding="16,8,16,16"
                    Spacing="16">
                    <TextBlock Text="Параметры" Style="{StaticResource TitleTextBlockStyle}" />

                    <TextBlock Text="Библиотеки" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Пути к библиотеке видео" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="Индексируются только видеофайлы."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="AddVideoFolderButton"
                                    Grid.Column="1"
                                    Click="AddVideoFolder_Click"
                                    Content="Добавить папку" />
                            </Grid>

                            <ListView
                                x:Name="VideoRootsList"
                                MaxHeight="160"
                                ItemsSource="{x:Bind VideoRoots, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <Button
                                                Grid.Column="1"
                                                Click="RemoveVideoFolder_Click"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="Убрать папку">
                                                <SymbolIcon Symbol="Remove" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                Text="Музыка не индексируется: проект работает только с видео."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Обновить библиотеки" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button
                                x:Name="RefreshLibrariesButton"
                                Click="RefreshLibraries_Click"
                                Content="Обновить" />
                            <TextBlock
                                Text="Если вы видите не все файлы, повторите индексацию."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <HyperlinkButton
                                Click="OpenIndexingSettings_Click"
                                Content="Управление параметрами индексирования системы" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Персонализация" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Тема приложения" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="ThemeComboBox"
                                SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Использовать параметры системы" Tag="system" />
                                <ComboBoxItem Content="Светлая" Tag="light" />
                                <ComboBoxItem Content="Тёмная" Tag="dark" />
                            </ComboBox>

                            <TextBlock Text="Контрастный цвет" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ComboBox
                                x:Name="AccentComboBox"
                                SelectionChanged="AccentComboBox_SelectionChanged">
                                <ComboBoxItem Content="Использовать системный акцент" Tag="system" />
                            </ComboBox>
                            <TextBlock
                                Text="Пользовательские акценты — следующий этап."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />

                            <ToggleSwitch
                                x:Name="ArtworkToggle"
                                Header="Искать обложки в Интернете"
                                Toggled="ArtworkToggle_Toggled" />
                            <TextBlock
                                Text="Обложки появятся вместе с метаданными в следующем этапе."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
            </Grid>
        </NavigationView>

        <!--  Транспорт  -->
        <Border
            x:Name="TransportBar"
            Grid.Row="1"
            Padding="16,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        x:Name="SeekSlider"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        Minimum="0"
                        PointerCaptureLost="SeekSlider_PointerCaptureLost"
                        PointerPressed="SeekSlider_PointerPressed"
                        PointerReleased="SeekSlider_PointerReleased"
                        StepFrequency="1000"
                        ValueChanged="SeekSlider_ValueChanged" />
                    <TextBlock
                        x:Name="TimeText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Text="00:00 / 00:00" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="160"
                        Height="90"
                        Background="Black"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <vlc:VideoView x:Name="VideoView" Background="Black" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            x:Name="BarTitle"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Ничего не играет"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            x:Name="BarSubtitle"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Выберите песню двойным кликом"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="PreviousButton"
                            Click="Previous_Click"
                            ToolTipService.ToolTip="Предыдущая (Ctrl+←)">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                        <Button
                            Click="SkipBack_Click"
                            Content="−10"
                            ToolTipService.ToolTip="Назад на 10 секунд" />
                        <Button
                            x:Name="PlayPauseButton"
                            Click="PlayPause_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Играть/пауза (Space)">
                            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                        </Button>
                        <Button
                            Click="SkipForward_Click"
                            Content="+30"
                            ToolTipService.ToolTip="Вперёд на 30 секунд" />
                        <Button
                            x:Name="NextButton"
                            Click="Next_Click"
                            ToolTipService.ToolTip="Следующая (Ctrl+→)">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="MuteButton"
                            Click="Mute_Click"
                            ToolTipService.ToolTip="Звук">
                            <SymbolIcon x:Name="MuteIcon" Symbol="Volume" />
                        </Button>
                        <Slider
                            x:Name="VolumeSlider"
                            Width="80"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="VolumeSlider_ValueChanged" />
                        <Button
                            x:Name="StopButton"
                            Click="Stop_Click"
                            ToolTipService.ToolTip="Стоп">
                            <SymbolIcon Symbol="Stop" />
                        </Button>
                        <Button
                            x:Name="DetachButton"
                            Click="Detach_Click"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Открепить видео">
                            <FontIcon Glyph="&#xE8A7;" />
                        </Button>
                        <Button
                            x:Name="FullScreenButton"
                            Click="FullScreen_Click"
                            ToolTipService.ToolTip="Полный экран (F11)">
                            <SymbolIcon Symbol="FullScreen" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Строка, когда видео откреплено  -->
        <Border
            x:Name="DetachedBar"
            Grid.Row="1"
            Padding="20,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Видео в отдельном окне" />
                <Button
                    Click="ReturnVideo_Click"
                    Content="Вернуть видео"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
