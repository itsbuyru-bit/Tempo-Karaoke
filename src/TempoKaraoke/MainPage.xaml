<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TempoKaraoke.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:TempoKaraoke.Converters"
    xmlns:controls="using:TempoKaraoke.Controls"
    xmlns:models="using:TempoKaraoke.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:TempoKaraoke.Views"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    KeyDown="Page_KeyDown" xmlns:loc="using:TempoKaraoke">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="F"
            Invoked="QuickSearchAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="I"
            Invoked="MediaInfoAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="E"
            Invoked="EqualizerAccelerator_Invoked"
            Modifiers="Control,Shift" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <LinearGradientBrush x:Key="EmptyStateGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6EDEFC" Offset="0" />
            <GradientStop Color="#FF659EE2" Offset="0.33" />
            <GradientStop Color="#FF905ECD" Offset="0.65" />
            <GradientStop Color="#FFD82684" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="EmptyStateGradientHover" StartPoint="1,0" EndPoint="0,1">
            <GradientStop Color="#FFD82684" Offset="0" />
            <GradientStop Color="#FF905ECD" Offset="0.35" />
            <GradientStop Color="#FF659EE2" Offset="0.67" />
            <GradientStop Color="#FF6EDEFC" Offset="1" />
        </LinearGradientBrush>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="QueuePlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaylistCoverPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                            <ContentPresenter
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardOverlayPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF00A3FF" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#66FFFFFF" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF0077CC" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardOverlayMoreButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#B3181818" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#E62B2B2B" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#59FFFFFF" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Surface" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF3A3A3A" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaCardItemStyle" TargetType="GridViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="QuickSearchActionButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
        <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
        <DataTemplate x:Key="MediaGroupCardTemplate" x:DataType="models:MediaGroup">
            <Grid
                Width="230"
                Height="200"
                ContextRequested="MediaCard_ContextRequested"
                HorizontalAlignment="Center"
                PointerEntered="VideoCard_PointerEntered"
                PointerExited="VideoCard_PointerExited"
                VerticalAlignment="Top">
                <Border
                    x:Name="CardSurface"
                    Margin="2"
                    Padding="4"
                    Background="{ThemeResource VideoCardBackgroundBrush}"
                    BorderBrush="{ThemeResource VideoCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    VerticalAlignment="Top">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="122" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>

                        <Border
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderThickness="0"
                            CornerRadius="8">
                            <Grid>
                                <Image
                                    Source="{Binding Thumbnail}"
                                    DataContextChanged="MediaThumbnail_DataContextChanged"
                                    Loaded="MediaThumbnail_Loaded"
                                    Stretch="UniformToFill" />
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="36"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE90B;"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                <Button
 Margin="4,4,4,0" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="{Binding VersionCountText}" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Click="Versions_Click" CornerRadius="4" MinHeight="24" Tag="{Binding}" Visibility="{Binding HasMultipleVersions, Converter={StaticResource BoolToVisibility}}" loc:Localization.ToolTipKey="Ui_Versions_ToolTip.ToolTip">
                                    <TextBlock
                                        FontSize="12"
                                        Text="{Binding VersionCountText}" />
                                </Button>
                                <Grid
                                    x:Name="CardOverlay"
                                    Background="Transparent"
                                    Opacity="0">
                                    <Button
 Width="48" Height="48" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardOverlayPlayButtonStyle}" Click="PlayGroup_Click" CornerRadius="24" MinHeight="48" MinWidth="48" Tag="{Binding}" loc:Localization.AutomationNameKey="ContextMenu_Play_AutomationName.AutomationName" loc:Localization.ToolTipKey="ContextMenu_Play_ToolTip.ToolTip">
                                        <SymbolIcon Symbol="Play" />
                                    </Button>
                                    <Button
 Width="36" Height="36" Margin="6" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource CardOverlayMoreButtonStyle}" Click="MoreGroup_Click" CornerRadius="8" MinHeight="36" MinWidth="36" Tag="{Binding}" loc:Localization.AutomationNameKey="Ui_More_AutomationName.AutomationName" loc:Localization.ToolTipKey="Ui_More_ToolTip.ToolTip">
                                        <FontIcon FontSize="16" Foreground="White" Glyph="&#xE712;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            MaxLines="2"
                            Text="{Binding DisplayTitle}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding DurationCaption}" />
                    </Grid>
                </Border>

                <Border
                    x:Name="SelectionRing"
                    Margin="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                <CheckBox
                    x:Name="CardSelectCheck"
                    Margin="10,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding DisplayTitle}"
                    Checked="CardSelectCheck_Changed"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    Unchecked="CardSelectCheck_Changed"
                    Visibility="{Binding ShowSelectionCheck, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="FolderItemsPanel">
            <ItemsWrapGrid
                ItemHeight="216"
                ItemWidth="240"
                Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="FolderEntryCardTemplate" x:DataType="models:FolderEntry">
            <Grid
                Width="230"
                Height="208"
                HorizontalAlignment="Center"
                DoubleTapped="FolderEntry_DoubleTapped"
                PointerEntered="FolderEntry_PointerEntered"
                PointerExited="FolderEntry_PointerExited"
                RightTapped="FolderEntry_RightTapped"
                Tapped="FolderEntry_Tapped"
                VerticalAlignment="Top">
                <Border
                    Margin="2"
                    Padding="4"
                    Background="Transparent"
                    CornerRadius="8">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="128" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>

                        <Border
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            CornerRadius="6">
                            <Grid>
                                <Image
                                    Source="{Binding Thumbnail}"
                                    DataContextChanged="MediaThumbnail_DataContextChanged"
                                    Loaded="MediaThumbnail_Loaded"
                                    Stretch="UniformToFill"
                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="36"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8F7;"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}" />

                                <Grid
                                    x:Name="FolderCardOverlay"
                                    Background="Transparent"
                                    Opacity="0">
                                    <Button
 x:Name="FolderCardPlay" Width="48" Height="48" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="FolderEntryPlay_Click" IsHitTestVisible="False" Style="{StaticResource CardOverlayPlayButtonStyle}" Tag="{Binding}" loc:Localization.AutomationNameKey="ContextMenu_Play_4_AutomationName.AutomationName" loc:Localization.ToolTipKey="ContextMenu_Play_4_ToolTip.ToolTip">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="18"
                                            Foreground="White"
                                            Glyph="&#xE768;" />
                                    </Button>
                                    <Button
 x:Name="FolderCardMore" Width="36" Height="36" Margin="6" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource CardOverlayMoreButtonStyle}" Click="FolderEntryMore_Click" CornerRadius="8" IsHitTestVisible="False" Tag="{Binding}" loc:Localization.AutomationNameKey="Ui_More_5_AutomationName.AutomationName" loc:Localization.ToolTipKey="Ui_More_5_ToolTip.ToolTip">
                                        <FontIcon FontSize="16" Foreground="White" Glyph="&#xE712;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            MaxLines="2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding CountText}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

    </Page.Resources>

    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="320"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Tag="home" x:Uid="Navigation_Home" loc:Localization.Key="Navigation_Home.Content">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
 x:Name="LibraryNavItem" IsSelected="True" Tag="library" x:Uid="Navigation_VideoLibrary" loc:Localization.Key="Navigation_VideoLibrary.Content">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="QueueNavItem" Tag="queue" x:Uid="Navigation_Queue" loc:Localization.Key="Navigation_Queue.Content">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="PlaylistsNavItem"
                    IsExpanded="False"
                    Tag="playlists"
                    x:Uid="Navigation_Playlists"
                    loc:Localization.Key="Navigation_Playlists.Content">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem
 x:Name="RemoteNavItem" IsExpanded="False" SelectsOnInvoked="False" Tag="remote" x:Uid="Navigation_Remote" loc:Localization.Key="Navigation_Remote.Content">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EA;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem
 x:Name="RemoteConnectionNavItem" Tag="remote" x:Uid="Ui_Connection" loc:Localization.Key="Ui_Connection.Content">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xED14;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
 x:Name="RemoteParticipantsNavItem" Tag="remote-participants" x:Uid="Navigation_Participants" loc:Localization.Key="Navigation_Participants.Content">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE716;" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.InfoBadge>
                                <InfoBadge
                                    x:Name="RemoteParticipantsBadge"
                                    Style="{ThemeResource AttentionValueInfoBadgeStyle}"
                                    Visibility="Collapsed" />
                            </NavigationViewItem.InfoBadge>
        
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SearchResultsNavItem"
                    Tag="search-results"
                    Visibility="Collapsed" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Tag="settings"
                    AutomationProperties.AutomationId="SettingsNavItem"
                    HorizontalContentAlignment="Stretch">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="SettingsUpdateCompactBadge"
                            AutomationProperties.AutomationId="SettingsUpdateCompactBadge"
                            Style="{ThemeResource AttentionValueInfoBadgeStyle}"
                            Value="1"
                            Visibility="Collapsed"
                            loc:Localization.AutomationNameKey="Update_Badge_AutomationName.AutomationName"
                            loc:Localization.ToolTipKey="Update_Badge_ToolTip.ToolTip" />
                    </NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Content>
                        <Grid
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="SettingsNavText"
                                VerticalAlignment="Center"
                                loc:Localization.Key="Ui_Settings_123.Text" />
                            <Border
                                x:Name="SettingsUpdatePlaque"
                                Grid.Column="1"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10"
                                Tapped="SettingsUpdatePlaque_Tapped"
                                Visibility="Collapsed"
                                loc:Localization.AutomationNameKey="Update_BadgePlaque_AutomationName.AutomationName"
                                loc:Localization.ToolTipKey="Update_BadgePlaque_ToolTip.ToolTip">
                                <TextBlock
                                    x:Name="SettingsUpdatePlaqueText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavItem" Tag="about" x:Uid="Navigation_About" loc:Localization.Key="Navigation_About.Content">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                    
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneHeader>
                <Border Height="48" Background="Transparent" />
            </NavigationView.PaneHeader>

            <Grid Padding="0,44,0,0">
        <!--  Главная  -->
        <Grid
            x:Name="HomeView"
            Padding="20,0,20,12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Padding="20,0,20,2"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleLargeTextBlockStyle}"
                    x:Uid="Navigation_Home_15"
                    loc:Localization.Key="Navigation_Home_15.Text" />
                <SelectorBar
                    x:Name="HomeSelector"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    SelectionChanged="HomeSelector_SelectionChanged">
                    <SelectorBarItem
