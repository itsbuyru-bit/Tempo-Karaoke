<?xml version="1.0" encoding="utf-8"?>
<!--
  Портативная сборка для установщика Inno Setup (без MSIX identity).
  Windows App SDK остаётся framework-dependent: установщик проверяет рантайм 2.6.
  .NET кладётся рядом (SelfContained), чтобы не требовать установки рантайма.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <!-- Windows App SDK кладём рядом с exe: на целевой машине ничего доустанавливать не нужно. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\portable\</PublishDir>
  </PropertyGroup>
</Project>
